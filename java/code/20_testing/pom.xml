<?xml version="1.0" encoding="UTF-8"?>
<!--
  最小可用的 Maven 配置：编译 Java 21 + 引入 JUnit 5 + 让 mvn test 能跑测试。
  真实项目的 pom 会更长（更多依赖、插件、profile），但骨架就是这些。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 项目坐标：组织.id : 项目名 : 版本，是 Maven 仓库里的唯一标识 -->
    <groupId>com.example</groupId>
    <artifactId>calc</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>   <!-- 用 Java 25 编译 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- JUnit 5（Jupiter）。scope=test：只在测试期可用，不会打进产物 jar -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Surefire 插件负责在 mvn test 阶段发现并运行 JUnit 测试 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
